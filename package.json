{
  "name": "zc-code",
  "version": "0.1.0",
  "description": "ZC CODE — An extensible AI-powered coding agent CLI with multi-model support, MCP integration, tools, plugins, permissions, and custom agents.",
  "commandName": "zc",
  "bin": {
    "zc": "dist/index.js"
  },
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "postinstall": "node -e \"console.log('ZC CODE installed. Run: zc --help')\""
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "mcp",
    "termux",
    "typescript",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "nvidia-nim",
    "openrouter"
  ],
  "author": "ZENUS (raj998302-art)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raj998302-art/zc-code.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "figlet": "^1.8.0",
    "ink": "^5.1.1",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "sql.js": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/figlet": "^1.7.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.6.3"
  }
}
